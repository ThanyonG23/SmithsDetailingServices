# ===========================================================
#  SMITHS DETAILING — ENVIRONMENT VARIABLES
#  Copy this file to ".env.local" and fill in the values.
#  NEVER commit .env.local (it's already in .gitignore).
# ===========================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://smithsdetailingservices.com.au

# --- Daily Ops dashboard (/ops) ---
# The shared password you and Ashlee type in to log in.
OPS_PASSWORD=choose-a-strong-shared-password
# Any long random string — used to sign the login cookie so it can't be
# forged. Generate one with:  openssl rand -hex 32
OPS_SECRET=paste-a-long-random-string-here

# --- Vercel Postgres (stores the daily logs) ---
# You do NOT set these by hand. When you create a Postgres database in the
# Vercel dashboard and connect it to this project, Vercel injects
# POSTGRES_URL (and friends) automatically. For LOCAL dev, pull them with:
#   vercel env pull .env.local
# POSTGRES_URL=postgres://...
